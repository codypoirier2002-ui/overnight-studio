# Copy this file to .env (same folder) and paste your key after the = sign.
# .env is git-ignored and only the server reads it: the key never reaches the browser.
ANTHROPIC_API_KEY=

# Optional knobs (defaults shown)
# OGS_CODER_MODEL=claude-opus-5-5      # strong model that writes the game code
# OGS_CHATTER_MODEL=claude-haiku-5-5   # cheap, fast model for the crew's chatter
# OGS_CODER_EFFORT=high                # low | medium | high | xhigh | max
# OGS_DAILY_CALL_CAP=60                # all Claude calls per day (UTC)
# OGS_DAILY_CODER_CAP=16               # code-writing calls per day (each night uses 1 to 4)
# PORT=8787
# HOST=127.0.0.1                       # set 0.0.0.0 to play from a phone on your Wi-Fi
